{
  "id": "com.paca.email-notifications",
  "displayName": "Email Notifications",
  "description": "Duplicates Paca notifications (task assignments, mentions, and updates) to user email addresses via Yandex Cloud Postbox, Resend, SendGrid, Mailgun, Postmark, Brevo, or Webhooks, using username as the recipient email.",
  "version": "0.1.0",
  "minCoreVersion": "v0.11.2",
  "permissions": [
    "db.read",
    "db.write",
    "events.subscribe",
    "cache",
    "fetch"
  ],
  "backend": {
    "allowedOutboundDomains": ["*"],
    "eventSubscriptions": [
      "notification.created",
      "task.created",
      "task.updated",
      "task.comment.added"
    ],
    "routes": [
      {
        "method": "GET",
        "path": "/projects/:projectId/email-notifications/settings",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["projects.read"]
          }
        ]
      },
      {
        "method": "PATCH",
        "path": "/projects/:projectId/email-notifications/settings",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["projects.write"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/email-notifications/logs",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["projects.read"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/email-notifications/test",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["projects.write"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/admin/email-notifications/settings",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "global",
            "permissions": ["users.read"]
          }
        ]
      },
      {
        "method": "PATCH",
        "path": "/admin/email-notifications/settings",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "global",
            "permissions": ["users.write"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/admin/email-notifications/logs",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "global",
            "permissions": ["users.read"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/admin/email-notifications/test",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "global",
            "permissions": ["users.write"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/admin/email-notifications/overrides",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "global",
            "permissions": ["users.read"]
          }
        ]
      },
      {
        "method": "PUT",
        "path": "/admin/email-notifications/overrides/:userId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "global",
            "permissions": ["users.write"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/admin/email-notifications/overrides/:userId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "global",
            "permissions": ["users.write"]
          }
        ]
      },
      {
        "method": "DELETE",
        "path": "/admin/email-notifications/overrides/:userId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "global",
            "permissions": ["users.write"]
          }
        ]
      }
    ]
  },
  "frontend": {
    "remoteEntryUrl": "/plugins/com.paca.email-notifications/assets/remoteEntry.js",
    "extensionPoints": [
      {
        "point": "project.settings.tab",
        "component": "ProjectEmailSettingsTab",
        "label": "Email Notifications",
        "order": 10
      },
      {
        "point": "admin.page",
        "component": "AdminEmailSettingsPage",
        "label": "Email Notifications",
        "order": 10
      }
    ],
    "navItems": [
      {
        "scope": "admin",
        "slug": "email-notifications",
        "label": "Email Notifications",
        "icon": "Mail",
        "component": "AdminEmailSettingsPage",
        "order": 10
      }
    ]
  },
  "mcp": {
    "remoteEntryUrl": "/plugins-mcp/com.paca.email-notifications/mcp.js"
  },
  "skills": {
    "baseUrl": "/plugins-skills/com.paca.email-notifications",
    "names": [
      "paca-email-notifications"
    ]
  }
}
