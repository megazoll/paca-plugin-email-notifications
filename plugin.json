{
  "id": "com.paca.email-notifications",
  "displayName": "Email Notifications",
  "description": "Duplicates Paca notifications (task assignments, mentions, and updates) to user email addresses via Yandex Cloud Postbox, Resend, SendGrid, Mailgun, Postmark, Brevo, or Webhooks, using username as the recipient email.",
  "version": "0.1.0",
  "minCoreVersion": "v0.11.2",
  "permissions": [
    "db.read",
    "db.write",
    "events.subscribe",
    "cache",
    "fetch"
  ],
  "backend": {
    "allowedOutboundDomains": ["*"],
    "eventSubscriptions": [
      "notification.created",
      "task.created",
      "task.updated",
      "task.comment.added"
    ],
    "routes": [
      {
        "method": "GET",
        "path": "/projects/:projectId/email-notifications/settings",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["projects.read"]
          }
        ]
      },
      {
        "method": "PATCH",
        "path": "/projects/:projectId/email-notifications/settings",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["projects.write"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/email-notifications/logs",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["projects.read"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/email-notifications/test",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["projects.write"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/admin/email-notifications/settings",
        "middlewares": [
          { "name": "requireAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "instance",
            "permissions": ["instance.admin"]
          }
        ]
      },
      {
        "method": "PATCH",
        "path": "/admin/email-notifications/settings",
        "middlewares": [
          { "name": "requireAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "instance",
            "permissions": ["instance.admin"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/admin/email-notifications/logs",
        "middlewares": [
          { "name": "requireAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "instance",
            "permissions": ["instance.admin"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/admin/email-notifications/test",
        "middlewares": [
          { "name": "requireAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "instance",
            "permissions": ["instance.admin"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/admin/email-notifications/overrides",
        "middlewares": [
          { "name": "requireAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "instance",
            "permissions": ["instance.admin"]
          }
        ]
      },
      {
        "method": "PUT",
        "path": "/admin/email-notifications/overrides/:userId",
        "middlewares": [
          { "name": "requireAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "instance",
            "permissions": ["instance.admin"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/admin/email-notifications/overrides/:userId",
        "middlewares": [
          { "name": "requireAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "instance",
            "permissions": ["instance.admin"]
          }
        ]
      },
      {
        "method": "DELETE",
        "path": "/admin/email-notifications/overrides/:userId",
        "middlewares": [
          { "name": "requireAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "instance",
            "permissions": ["instance.admin"]
          }
        ]
      }
    ]
  },
  "extensions": [
    {
      "point": "project.settings.tab",
      "component": "ProjectEmailSettingsTab",
      "title": "Email Notifications"
    },
    {
      "point": "admin.page",
      "component": "AdminEmailSettingsPage",
      "title": "Email Notifications",
      "route": "/admin/email-notifications"
    }
  ],
  "mcp": {
    "module": "dist/mcp.js",
    "tools": [
      {
        "name": "email_notifications_get_settings",
        "description": "Get email notification settings (global or for a specific project)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": { "type": "string", "description": "Optional project UUID" }
          }
        }
      },
      {
        "name": "email_notifications_update_settings",
        "description": "Update email notification configuration (provider, endpoint, API key, from address, triggers)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": { "type": "string", "description": "Optional project UUID" },
            "provider": { "type": "string", "description": "Provider: yandex_postbox, resend, sendgrid, mailgun, postmark, brevo, webhook" },
            "endpoint": { "type": "string", "description": "API Endpoint URL" },
            "api_key": { "type": "string", "description": "API Key / IAM Token" },
            "from_email": { "type": "string", "description": "Sender email address" },
            "from_name": { "type": "string", "description": "Sender display name" },
            "notify_on_assign": { "type": "boolean" },
            "notify_on_mention": { "type": "boolean" },
            "notify_on_update": { "type": "boolean" }
          }
        }
      },
      {
        "name": "email_notifications_get_logs",
        "description": "Get recent email dispatch logs (audit trail)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": { "type": "string", "description": "Optional project UUID" },
            "limit": { "type": "number", "description": "Number of log entries (default: 50)" }
          }
        }
      },
      {
        "name": "email_notifications_send_test",
        "description": "Send a test email using current or custom configuration",
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": { "type": "string", "description": "Optional project UUID" },
            "recipient_email": { "type": "string", "description": "Target test email address" },
            "provider": { "type": "string" },
            "endpoint": { "type": "string" },
            "api_key": { "type": "string" },
            "from_email": { "type": "string" },
            "from_name": { "type": "string" }
          },
          "required": ["recipient_email"]
        }
      },
      {
        "name": "email_notifications_list_overrides",
        "description": "List all user ID to email override mappings",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "email_notifications_save_override",
        "description": "Map a user ID to a specific email address",
        "inputSchema": {
          "type": "object",
          "properties": {
            "user_id": { "type": "string", "description": "User UUID" },
            "email": { "type": "string", "description": "Email address" }
          },
          "required": ["user_id", "email"]
        }
      },
      {
        "name": "email_notifications_delete_override",
        "description": "Remove a user ID to email override mapping",
        "inputSchema": {
          "type": "object",
          "properties": {
            "user_id": { "type": "string", "description": "User UUID" }
          },
          "required": ["user_id"]
        }
      }
    ]
  },
  "skills": {
    "names": [
      "paca-email-notifications"
    ]
  }
}
